[Unit]
Description=Vibe-Research API
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/Vibe-Research-main/backend
EnvironmentFile=-/root/Vibe-Research-main/backend/.env
ExecStart=/root/miniconda3/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8900
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
